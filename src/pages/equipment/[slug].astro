---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ItemCard from '../../components/ItemCard.astro';
import { categories, catName, items } from '../../data/equipment';
import { site } from '../../data/site';

export function getStaticPaths() {
  return items.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}
const { item } = Astro.props;
const icon = categories.find((c) => c.slug === item.category)?.icon ?? 'truck';
const related = items.filter((i) => i.category === item.category && i.slug !== item.slug).slice(0, 3);
---
<Layout title={`${item.name} Rental | West Ridge Rentals`} description={`Rent a ${item.name} in Utah. ${item.blurb}`}>
  <div class="max-w-7xl mx-auto px-4 py-10">
    <nav class="text-sm text-wr-muted mb-6" aria-label="Breadcrumb">
      <a href="/equipment/" class="hover:text-wr-yellow">Equipment</a> /
      <a href={`/equipment/?category=${item.category}`} class="hover:text-wr-yellow">{catName(item.category)}</a> /
      <span class="text-wr-text">{item.name}</span>
    </nav>

    <div class="grid md:grid-cols-2 gap-10">
      <div class="aspect-[4/3] bg-wr-steel border border-wr-line flex flex-col items-center justify-center gap-3 text-wr-muted">
        <Icon name={icon} class="w-24 h-24" />
        <span class="text-xs uppercase tracking-widest">Photo coming soon</span>
      </div>

      <div>
        <p class="text-xs uppercase tracking-widest text-wr-yellow">{catName(item.category)}</p>
        <h1 class="text-5xl mt-2">{item.name}</h1>
        <p class="text-wr-muted text-lg mt-4">{item.blurb}</p>
        <p class="mt-6 font-display text-3xl text-wr-white">{item.rate}</p>
        <p class="text-sm text-wr-muted">Daily, weekly and monthly rates. We'll confirm pricing with your request.</p>

        <div class="mt-6 flex flex-wrap gap-3">
          <button type="button" class="btn btn-primary" data-add data-slug={item.slug} data-name={item.name}><span data-add-label>Add to request</span></button>
          <a href="/request/" class="btn btn-ghost">View request list</a>
        </div>

        <ul class="mt-6 text-sm text-wr-text space-y-1">
          <li>{item.delivery ? '✓ Delivery available' : '✓ Pickup only'}</li>
          <li>✓ Availability confirmed by our team before you commit</li>
        </ul>

        <div class="mt-8 border border-wr-line bg-wr-char p-5">
          <h2 class="text-xl mb-3">Specs</h2>
          <dl class="divide-y divide-wr-line">
            {item.specs.map(([k, v]) => (
              <div class="flex justify-between gap-4 py-2"><dt class="text-wr-muted">{k}</dt><dd class="text-wr-white text-right">{v}</dd></div>
            ))}
          </dl>
          <h3 class="text-lg mt-5 mb-2">Features</h3>
          <ul class="flex flex-wrap gap-2">
            {item.features.map((f) => <li class="text-sm px-3 py-1 border border-wr-line">{f}</li>)}
          </ul>
        </div>
        <p class="mt-4 text-sm text-wr-muted">Questions? Call <a class="text-wr-yellow" href={site.phoneHref}>{site.phone}</a>.</p>
      </div>
    </div>

    {related.length > 0 && (
      <section class="mt-16">
        <h2 class="text-3xl mb-6">More in {catName(item.category)}</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">{related.map((i) => <ItemCard item={i} />)}</div>
      </section>
    )}
  </div>
</Layout>
