---
import Layout from '../../../layouts/Layout.astro';
import PageHero from '../../../components/PageHero.astro';
import ItemCard from '../../../components/ItemCard.astro';
import { categories, items } from '../../../data/equipment';
import { site } from '../../../data/site';
import { catImg, itemImg } from '../../../lib/images';
import { photo } from '../../../lib/photo';

export function getStaticPaths() {
  return categories.map((cat) => ({ params: { category: cat.slug }, props: { cat } }));
}
const { cat } = Astro.props;
const list = items.filter((i) => i.category === cat.slug);
const lead = list[0];
const leadP = await photo(itemImg(lead.slug), 700);
---
<Layout title={`${cat.name} Rentals in Utah | West Ridge Rentals`} description={cat.intro}>
  <PageHero eyebrow={`${cat.name} rentals`} kicker={cat.kicker} title={cat.h1} intro={cat.intro} primary={['Request a rental', '/request']} secondary={['See the fleet', '#fleet']} image={catImg(cat.slug)} alt={`${cat.name} equipment at work`} />

  <section class="section section-gray" id="fleet">
    <div class="container">
      <div class="head">
        <div><p class="eyebrow">Available to rent</p><h2 class="h2">{cat.name} fleet</h2></div>
        <a href="/equipment" class="btn-outline">All equipment</a>
      </div>
      <div class="grid">{list.map((i) => <ItemCard item={i} />)}</div>
    </div>
  </section>

  <section class="section section-white">
    <div class="container why">
      <div class="photo-wrap">
        <img src={leadP.src} srcset={leadP.srcset} sizes="(max-width: 900px) 92vw, 560px" alt={`${lead.name} ready for a job`} width={leadP.width} height={leadP.height} loading="lazy" decoding="async" />
        <span class="pill badge"><strong>{cat.badge[0]}</strong><span>{cat.badge[1]}</span></span>
      </div>
      <div>
        <p class="eyebrow">Why West Ridge</p>
        <h2 class="h2" style="margin-bottom: 1.25rem;">{cat.whyTitle}</h2>
        {cat.whyBody.map((p) => <p class="lead" style="margin-bottom: 1rem;">{p}</p>)}
        <ul class="check-list" style="margin: 1.5rem 0 2rem;">{cat.checklist.map((c) => <li>{c}</li>)}</ul>
        <a href="/request" class="btn-primary">Request {cat.name.toLowerCase()}</a>
      </div>
    </div>
  </section>

  <section class="section section-mid">
    <div class="container">
      <div style="text-align: center; margin-bottom: 2.5rem;">
        <p class="eyebrow">Common questions</p>
        <h2 class="h2">{cat.name} FAQ</h2>
      </div>
      <div class="faq">
        {cat.faqs.map(([q, a]) => (
          <div class="card card-accent" style="padding: 1.25rem 1.5rem;"><h3 class="q">{q}</h3><p class="a">{a}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="band">
    <div class="container band-inner">
      <div>
        <h2>Get your {cat.name.split(' ')[0].toLowerCase()} rental quote</h2>
        <p>Tell us your dates and job details and our team will confirm availability and pricing, usually within one business day.</p>
      </div>
      <a href="/request" class="btn-dark">Request a rental</a>
    </div>
  </section>
</Layout>

<style>
  .head { display: flex; justify-content: space-between; align-items: flex-end; gap: 1.5rem; flex-wrap: wrap; margin-bottom: 2.25rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 1.5rem; }
  .why { display: grid; grid-template-columns: 1fr 1fr; gap: 4.5rem; align-items: center; }
  .photo-wrap { position: relative; border-radius: 26px; aspect-ratio: 4/3; box-shadow: 0 24px 50px rgba(15,17,19,.16); }
  .photo-wrap img { width: 100%; height: 100%; object-fit: cover; border-radius: 26px; }
  .badge { position: absolute; right: -1rem; bottom: -1.25rem; box-shadow: 0 10px 24px rgba(244,123,0,.35); }
  .faq { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .q { font-family: var(--font-body); font-size: 1.02rem; font-weight: 700; letter-spacing: 0; margin-bottom: .4rem; }
  .a { font-size: .92rem; color: var(--color-wr-muted); line-height: 1.6; }
  .band { background: var(--color-wr-accent); color: var(--color-wr-ink); }
  .band-inner { display: flex; justify-content: space-between; align-items: center; gap: 2rem; flex-wrap: wrap; padding-top: 3.5rem; padding-bottom: 3.5rem; }
  .band h2 { font-size: clamp(1.7rem, 3.2vw, 2.4rem); font-weight: 800; margin-bottom: .4rem; }
  .band p { max-width: 34rem; font-weight: 500; }
  @media (max-width: 900px) { .why { grid-template-columns: 1fr; gap: 3rem; } .faq { grid-template-columns: 1fr; } .badge { right: .5rem; } }
</style>
