---
import Layout from '../../../layouts/Layout.astro';
import ItemCard from '../../../components/ItemCard.astro';
import AvailabilityCalendar from '../../../components/AvailabilityCalendar.astro';
import { categories, catName, items, pairs } from '../../../data/equipment';
import { site } from '../../../data/site';
import { money } from '../../../lib/pricing';
import { itemImg } from '../../../lib/images';
import { photo, hasPhoto } from '../../../lib/photo';
import EquipIcon from '../../../components/EquipIcon.astro';

export function getStaticPaths() {
  return items.map((item) => ({ params: { category: item.category, slug: item.slug }, props: { item } }));
}
const { item } = Astro.props;
const cat = categories.find((c) => c.slug === item.category)!;
const together = (pairs[item.slug] || []).map((s) => items.find((i) => i.slug === s)).filter(Boolean) as typeof items;
const mainP = hasPhoto(itemImg(item.slug)) ? await photo(itemImg(item.slug), 700) : null;
const related = items.filter((i) => i.category === item.category && i.slug !== item.slug).slice(0, 3);
---
<Layout title={`${item.name} Rental in Utah | West Ridge Rentals`} description={`Rent a ${item.name} in Utah. ${item.blurb}`}>
  <section class="section-white" style="padding: 2.25rem 0 4.5rem;">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/equipment">Equipment</a> / <a href={`/equipment/${item.category}`}>{catName(item.category)}</a> / <span>{item.name}</span>
      </nav>
      <div class="split">
        <div class="visual">{mainP
          ? <img src={mainP.src} srcset={mainP.srcset} sizes="(max-width: 800px) 92vw, 580px" alt={`${item.name} available to rent in Utah`} width={mainP.width} height={mainP.height} fetchpriority="high" decoding="async" />
          : <EquipIcon icon={item.icon} size="lg" />}</div>
        <div>
          <p class="eyebrow">{catName(item.category)}</p>
          <h1 class="h1" style="font-size: clamp(2rem, 4.4vw, 3.1rem);">{item.name}</h1>
          <p class="lead" style="margin-top: 1rem;">{item.blurb}</p>
          <div class="rates" aria-label="Rental rates">
            <div><span>Daily</span><strong>{money(item.rates[0])}</strong></div>
            <div><span>Weekly</span><strong>{money(item.rates[1])}</strong><small>Save {Math.round((1 - item.rates[1] / (item.rates[0] * 7)) * 100)}%</small></div>
            <div><span>Monthly</span><strong>{money(item.rates[2])}</strong><small>Save {Math.round((1 - item.rates[2] / (item.rates[0] * 30)) * 100)}%</small></div>
          </div>
          <p class="note">Weekly and monthly rates apply automatically to longer rentals. Delivery, fuel and taxes are extra. We confirm your total before anything is final.</p>
          {item.comingSoon && <p class="soon-note"><strong>Coming soon to our fleet.</strong> This machine isn't available to request yet. <a href="/contact">Ask us</a> about timing.</p>}
          {!item.comingSoon && <div class="qq card" data-qq data-slug={item.slug} data-rates={item.rates.join(',')}>
            <p class="qq-title">Your rental dates</p>
            <div class="qq-row">
              <div><label class="label" for="q-start">Start</label><input class="field" type="date" id="q-start" /></div>
              <div><label class="label" for="q-end">Return</label><input class="field" type="date" id="q-end" /></div>
            </div>
            <p class="qq-est" data-qq-est>Pick your dates to see your estimated total.</p>
            <p class="qq-warn" data-qq-warn hidden></p>
          </div>}
          <div style="display: flex; gap: .75rem; flex-wrap: wrap; margin: 1.5rem 0;">
            {item.comingSoon
              ? <a href="/contact" class="btn-primary">Ask about this machine</a>
              : <><button type="button" class="btn-primary" data-add data-slug={item.slug} data-name={item.name}><span data-add-label>Add to request</span></button>
                <a href="/request" class="btn-outline">Continue to request</a></>}
          </div>
          <ul class="check-list">
            <li>{item.delivery ? 'Delivery available' : 'Pickup only'}</li>
            <li>Availability confirmed by our team before you commit</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-gray">
    {!item.comingSoon && <div class="container" style="margin-bottom: 1.5rem;"><AvailabilityCalendar slug={item.slug} name={item.name} /></div>}
    <div class="container specs">
      <div class="card" style="padding: 1.75rem;">
        <h2 class="h2" style="font-size: 1.6rem; margin-bottom: 1rem;">Specs</h2>
        <dl>{item.specs.map(([k, v]) => <div class="row"><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
      </div>
      <div class="card" style="padding: 1.75rem;">
        <h2 class="h2" style="font-size: 1.6rem; margin-bottom: 1rem;">Features</h2>
        <ul class="check-list">{item.features.map((f) => <li>{f}</li>)}</ul>
        <p class="note" style="margin-top: 1.5rem;">Questions? Call <a href={site.phoneHref} style="color: #B45300; text-decoration: underline;">{site.phone}</a>.</p>
      </div>
      <div class="card" style="padding: 1.75rem; grid-column: 1 / -1;">
        <h2 class="h2" style="font-size: 1.6rem; margin-bottom: 1rem;">Common uses</h2>
        <ul class="check-list uses">{cat.uses.map((u) => <li>{u}</li>)}</ul>
      </div>
    </div>
  </section>

  {together.length > 0 && (
    <section class="section section-white">
      <div class="container">
        <div style="text-align: center; margin-bottom: 2.5rem;"><p class="eyebrow">Save a trip</p><h2 class="h2">Often rented together</h2></div>
        <div class="grid">{together.map((i) => <ItemCard item={i} />)}</div>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="section section-mid">
      <div class="container">
        <div style="text-align: center; margin-bottom: 2.5rem;"><p class="eyebrow">Keep looking</p><h2 class="h2">More in {catName(item.category)}</h2></div>
        <div class="grid">{related.map((i) => <ItemCard item={i} />)}</div>
      </div>
    </section>
  )}
</Layout>

<style>
  .crumbs { font-size: .85rem; color: var(--color-wr-muted); margin-bottom: 2rem; }
  .crumbs a:hover { color: #B45300; }
  .crumbs span { color: var(--color-wr-ink); }
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 3.5rem; align-items: start; }
  .visual { aspect-ratio: 4/3; border-radius: 26px; overflow: hidden; background: var(--color-wr-mid); box-shadow: 0 24px 50px rgba(15,17,19,.14); }
  .visual img { width: 100%; height: 100%; object-fit: cover; }
  .rates { display: grid; grid-template-columns: repeat(3, 1fr); margin: 1.5rem 0 .75rem; border: 1px solid var(--color-wr-border); border-radius: 16px; overflow: hidden; }
  .rates div { padding: .9rem 1rem; text-align: center; background: var(--color-wr-mid); }
  .rates div + div { border-left: 1px solid var(--color-wr-border); }
  .rates span { display: block; font-size: .7rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--color-wr-muted); }
  .rates strong { display: block; font-family: var(--font-heading); font-weight: 800; font-size: 1.9rem; line-height: 1.15; }
  .rates small { display: block; font-size: .68rem; font-weight: 700; color: var(--color-wr-amber); text-transform: uppercase; letter-spacing: .06em; }
  .qq { padding: 1rem 1.25rem; margin-top: 1.25rem; border-left: 4px solid var(--color-wr-accent); }
  .qq-title { font-size: .72rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--color-wr-amber); margin-bottom: .6rem; }
  .qq-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: .75rem; }
  .qq-row > div { min-width: 0; }
  .qq-est { margin-top: .75rem; font-weight: 600; }
  .qq-est.on { font-family: var(--font-heading); font-weight: 800; font-size: 1.35rem; }
  .qq-warn { margin-top: .4rem; font-size: .85rem; color: #7a2a00; background: #FDE8D8; padding: .5rem .75rem; border-radius: 10px; }
  .soon-note { margin-top: 1.25rem; background: #F6EAE2; border: 1px solid #E6CDBE; border-radius: 14px; padding: .9rem 1.1rem; font-size: .92rem; }
  .soon-note a { color: var(--color-wr-amber); text-decoration: underline; }
  .uses { grid-template-columns: 1fr 1fr; }
  .note { font-size: .85rem; color: var(--color-wr-muted); }
  .specs { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .row { display: flex; justify-content: space-between; gap: 1rem; padding: .7rem 0; border-bottom: 1px solid var(--color-wr-border); }
  .row dt { color: var(--color-wr-muted); } .row dd { text-align: right; font-weight: 500; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.5rem; }
  .split > *, .specs > * { min-width: 0; }
  @media (max-width: 800px) { .split, .specs { grid-template-columns: 1fr; gap: 2rem; } .uses { grid-template-columns: 1fr; } .rates strong { font-size: 1.5rem; } .rates div { padding: .75rem .4rem; } }
</style>

<script>
  import { loadAvailability, conflicts, nextFree, fmt, fmtRange, daysBetween, todayKey } from '../../../lib/availability';
  import { estimate, money } from '../../../lib/pricing';
  import { getDates, setDates } from '../../../lib/dates';

  const root = document.querySelector<HTMLElement>('[data-qq]');
  if (root) {
    const slug = root.dataset.slug!;
    const rates = root.dataset.rates!.split(',').map(Number) as [number, number, number];
    const s = document.getElementById('q-start') as HTMLInputElement;
    const e = document.getElementById('q-end') as HTMLInputElement;
    const est = root.querySelector<HTMLElement>('[data-qq-est]')!;
    const warn = root.querySelector<HTMLElement>('[data-qq-warn]')!;
    let avail = { ok: false, bookings: {} as Record<string, [string, string][]> };
    s.min = e.min = todayKey();

    const show = () => {
      warn.hidden = true;
      if (!s.value || !e.value || e.value < s.value) { est.classList.remove('on'); est.textContent = 'Pick your dates to see your estimated total.'; return; }
      const len = daysBetween(s.value, e.value) + 1;
      est.classList.add('on');
      est.textContent = `Estimate: ${money(estimate(rates, len))} for ${len} day${len === 1 ? '' : 's'}`;
      const c = avail.ok ? conflicts(avail, slug, s.value, e.value) : [];
      if (c.length) { warn.hidden = false; warn.textContent = `Booked ${c.map(fmtRange).join(', ')}. Next open for ${len} day${len === 1 ? '' : 's'}: ${fmt(nextFree(avail, slug, s.value, len))}.`; }
    };
    const pull = () => { const d = getDates(); s.value = d?.start ?? ''; e.value = d?.end ?? ''; if (s.value) e.min = s.value; show(); };
    const push = () => {
      if (s.value && e.value && e.value < s.value) e.value = s.value;
      if (s.value) e.min = s.value;
      if (s.value && e.value) setDates({ start: s.value, end: e.value }); else show();
    };
    s.addEventListener('change', push); e.addEventListener('change', push);
    window.addEventListener('wr-dates-changed', pull);
    pull();
    loadAvailability().then((a) => { avail = a as typeof avail; show(); });
  }
</script>
