---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';
import ItemCard from '../../../components/ItemCard.astro';
import AvailabilityCalendar from '../../../components/AvailabilityCalendar.astro';
import { categories, catName, items } from '../../../data/equipment';
import { site } from '../../../data/site';
import { money } from '../../../lib/pricing';

export function getStaticPaths() {
  return items.map((item) => ({ params: { category: item.category, slug: item.slug }, props: { item } }));
}
const { item } = Astro.props;
const icon = categories.find((c) => c.slug === item.category)?.icon ?? 'truck';
const related = items.filter((i) => i.category === item.category && i.slug !== item.slug).slice(0, 3);
---
<Layout title={`${item.name} Rental in Utah | West Ridge Rentals`} description={`Rent a ${item.name} in Utah. ${item.blurb}`}>
  <section class="section-white" style="padding: 2.5rem 0 4rem; border-bottom: 4px solid var(--color-wr-yellow);">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/equipment">Equipment</a> / <a href={`/equipment/${item.category}`}>{catName(item.category)}</a> / <span>{item.name}</span>
      </nav>
      <div class="split">
        <div class="visual"><Icon name={icon} class="w-28 h-28" /><span class="soon">Photo coming soon</span></div>
        <div>
          <p class="eyebrow">{catName(item.category)}</p>
          <h1 class="h1" style="font-size: clamp(2.2rem, 5vw, 3.4rem);">{item.name}</h1>
          <p class="lead" style="margin-top: 1rem;">{item.blurb}</p>
          <div class="rates" aria-label="Rental rates">
            <div><span>Daily</span><strong>{money(item.rates[0])}</strong></div>
            <div><span>Weekly</span><strong>{money(item.rates[1])}</strong><small>Save {Math.round((1 - item.rates[1] / (item.rates[0] * 7)) * 100)}%</small></div>
            <div><span>Monthly</span><strong>{money(item.rates[2])}</strong><small>Save {Math.round((1 - item.rates[2] / (item.rates[0] * 30)) * 100)}%</small></div>
          </div>
          <p class="note">Weekly and monthly rates apply automatically to longer rentals. Delivery, fuel and taxes are extra. We confirm your total before anything is final.</p>
          <div style="display: flex; gap: .75rem; flex-wrap: wrap; margin: 1.5rem 0;">
            <button type="button" class="btn-primary" data-add data-slug={item.slug} data-name={item.name}><span data-add-label>Add to request</span></button>
            <a href="/request" class="btn-outline">View Request List</a>
          </div>
          <ul class="check-list">
            <li>{item.delivery ? 'Delivery available' : 'Pickup only'}</li>
            <li>Availability confirmed by our team before you commit</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-gray">
    <div class="container" style="margin-bottom: 1.5rem;"><AvailabilityCalendar slug={item.slug} name={item.name} /></div>
    <div class="container specs">
      <div class="card" style="padding: 1.75rem;">
        <h2 class="h2" style="font-size: 1.6rem; margin-bottom: 1rem;">Specs</h2>
        <dl>{item.specs.map(([k, v]) => <div class="row"><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
      </div>
      <div class="card" style="padding: 1.75rem;">
        <h2 class="h2" style="font-size: 1.6rem; margin-bottom: 1rem;">Features</h2>
        <ul class="check-list">{item.features.map((f) => <li>{f}</li>)}</ul>
        <p class="note" style="margin-top: 1.5rem;">Questions? Call <a href={site.phoneHref} style="color: #8A5D00; text-decoration: underline;">{site.phone}</a>.</p>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section section-mid">
      <div class="container">
        <div style="text-align: center; margin-bottom: 2.5rem;"><p class="eyebrow">Keep looking</p><h2 class="h2">More in {catName(item.category)}</h2></div>
        <div class="grid">{related.map((i) => <ItemCard item={i} />)}</div>
      </div>
    </section>
  )}
</Layout>

<style>
  .crumbs { font-size: .85rem; color: var(--color-wr-muted); margin-bottom: 2rem; }
  .crumbs a:hover { color: #8A5D00; }
  .crumbs span { color: #121212; }
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 3.5rem; align-items: start; }
  .visual { aspect-ratio: 4/3; background: var(--color-wr-mid); border: 1px solid var(--color-wr-border); display: flex; flex-direction: column; gap: .75rem; align-items: center; justify-content: center; color: #b7bcb7; }
  .soon { font-size: .7rem; letter-spacing: .15em; text-transform: uppercase; }
  .rates { display: grid; grid-template-columns: repeat(3, 1fr); margin: 1.5rem 0 .75rem; border: 1px solid var(--color-wr-border); }
  .rates div { padding: .9rem 1rem; text-align: center; background: var(--color-wr-mid); }
  .rates div + div { border-left: 1px solid var(--color-wr-border); }
  .rates span { display: block; font-family: var(--font-heading); font-size: .75rem; letter-spacing: .15em; text-transform: uppercase; color: var(--color-wr-muted); }
  .rates strong { display: block; font-family: var(--font-heading); font-size: 2rem; line-height: 1.1; }
  .rates small { display: block; font-size: .7rem; font-weight: 600; color: #8A5D00; text-transform: uppercase; letter-spacing: .08em; }
  .note { font-size: .85rem; color: var(--color-wr-muted); }
  .specs { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .row { display: flex; justify-content: space-between; gap: 1rem; padding: .7rem 0; border-bottom: 1px solid var(--color-wr-border); }
  .row dt { color: var(--color-wr-muted); } .row dd { text-align: right; font-weight: 500; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.5rem; }
  @media (max-width: 800px) { .split, .specs { grid-template-columns: 1fr; gap: 2rem; } }
</style>
