---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ItemCard from '../components/ItemCard.astro';
import { categories, items } from '../data/equipment';
import { site, featuredCities } from '../data/site';
const featured = [items[0], items[3], items[5], items[7], items[10], items[2]];
// PLACEHOLDER stats: swap for real numbers once the client provides them.
const stats = [['Statewide', 'Utah-wide delivery'], ['4', 'Equipment categories'], ['$0', 'To send a request'], ['1 Day', 'Typical response']];
---
<Layout title="West Ridge Rentals | Truck & Equipment Rentals in Utah" description="Rent dump trucks, excavators, skid steers and landscaping equipment across Utah. Request your rental online and we'll confirm availability fast.">
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-inner">
      <div>
        <p class="kicker">Equipment rentals across Utah</p>
        <h1>Equipment that's ready when your job is.</h1>
        <p class="sub">Trucks, excavators and landscaping equipment for contractors and businesses. Build a request in minutes and our team handles the rest. Serving all of Utah.</p>
        <div class="actions">
          <a href="/request" class="btn-primary">Request a Rental</a>
          <a href="/equipment" class="btn-outline-light">Browse Equipment</a>
        </div>
      </div>
      <div class="tiles" aria-hidden="true">
        {categories.map((c) => <div class="tile"><Icon name={c.icon} class="w-16 h-16" /></div>)}
      </div>
    </div>
  </section>

  <!-- Stats band -->
  <section class="stats">
    <div class="container stats-grid">
      {stats.map(([n, l]) => <div><strong>{n}</strong><span>{l}</span></div>)}
    </div>
  </section>

  <!-- Categories -->
  <section class="section section-white">
    <div class="container">
      <div style="text-align: center; max-width: 40rem; margin: 0 auto 3rem;">
        <p class="eyebrow">What we rent</p>
        <h2 class="h2" style="margin-bottom: 1rem;">Everything you need. One call.</h2>
        <p class="lead">From hauling to digging to finishing, rent one machine or the whole lineup without juggling suppliers.</p>
      </div>
      <div class="cats">
        {categories.map((c) => (
          <a href={`/equipment/${c.slug}`} class="cat">
            <span class="ico"><Icon name={c.icon} class="w-9 h-9" /></span>
            <h3>{c.name}</h3>
            <p>{c.blurb}</p>
            <span class="more">Learn more &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Why -->
  <section class="section section-gray">
    <div class="container why">
      <div class="visual"><Icon name="excavator" class="w-32 h-32" /><span class="badge"><strong>1 Day</strong><small>Typical response</small></span></div>
      <div>
        <p class="eyebrow">Why West Ridge</p>
        <h2 class="h2" style="margin-bottom: 1.25rem;">Renting without the runaround</h2>
        <p class="lead" style="margin-bottom: 1.5rem;">Tell us what you need and when. {site.manager} and the team check availability, confirm pricing and arrange delivery so you can stay on the job.</p>
        <ul class="check-list" style="margin-bottom: 2rem;">
          <li><span><strong>One request, every machine.</strong> Build a list and send it in a single form.</span></li>
          <li><span><strong>Maintained equipment.</strong> Inspected between every rental.</span></li>
          <li><span><strong>Delivery or pickup.</strong> Your site or our yard, your call.</span></li>
          <li><span><strong>Real people.</strong> A quick call or email back, not a ticket number.</span></li>
        </ul>
        <a href="/how-it-works" class="btn-outline">See How It Works</a>
      </div>
    </div>
  </section>

  <!-- Fleet -->
  <section class="section section-white">
    <div class="container">
      <div style="text-align: center; margin-bottom: 3rem;">
        <p class="eyebrow">From the fleet</p>
        <h2 class="h2" style="margin-bottom: .75rem;">Popular rentals</h2>
        <p class="lead">Add what you need and send one request.</p>
      </div>
      <div class="grid">{featured.map((i) => <ItemCard item={i} />)}</div>
      <div style="text-align: center; margin-top: 2.5rem;"><a href="/equipment" class="btn-outline">View All Equipment &rarr;</a></div>
    </div>
  </section>

  <!-- Areas -->
  <section class="section section-gray">
    <div class="container areas">
      <div>
        <p class="eyebrow">Where we work</p>
        <h2 class="h2" style="margin-bottom: 1rem;">Serving all of Utah</h2>
        <p class="lead" style="margin-bottom: 1.75rem;">From Logan to St. George, we deliver equipment to job sites across the state.</p>
        <a href="/service-areas" class="btn-primary">View Service Areas</a>
      </div>
      <div class="chips">{featuredCities.map((c) => <span class="chip">{c}</span>)}</div>
    </div>
  </section>
</Layout>

<style>
  .hero { background: linear-gradient(135deg, #2a2d31 0%, #1d1f22 55%, #141517 100%); color: #fff; position: relative; overflow: hidden; }
  .hero::after { content: ''; position: absolute; right: -6rem; top: -6rem; width: 28rem; height: 28rem; border-radius: 50%; background: rgba(245,179,1,.12); filter: blur(60px); }
  .hero-inner { position: relative; z-index: 1; display: grid; grid-template-columns: 1.4fr 1fr; gap: 3rem; align-items: center; padding-top: 6rem; padding-bottom: 6rem; }
  .kicker { font-family: var(--font-heading); letter-spacing: .25em; text-transform: uppercase; font-size: .8rem; color: var(--color-wr-yellow); margin-bottom: 1rem; }
  .hero h1 { font-size: clamp(2.6rem, 7vw, 4.75rem); font-weight: 700; text-transform: uppercase; line-height: 1; color: #fff; margin-bottom: 1.5rem; }
  .sub { color: #c7cbd0; font-size: 1.1rem; line-height: 1.7; max-width: 34rem; margin-bottom: 2rem; }
  .actions { display: flex; gap: .75rem; flex-wrap: wrap; }
  .tiles { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; }
  .tile { aspect-ratio: 1; display: grid; place-items: center; border: 1px solid rgba(255,255,255,.12); background: rgba(0,0,0,.25); color: var(--color-wr-yellow); opacity: .85; }

  .stats { background: var(--color-wr-yellow); color: #121212; }
  .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); text-align: center; padding-top: 2.25rem; padding-bottom: 2.25rem; gap: 1rem; }
  .stats strong { display: block; font-family: var(--font-heading); font-size: 2.6rem; font-weight: 700; line-height: 1; }
  .stats span { font-family: var(--font-heading); font-size: .75rem; letter-spacing: .15em; text-transform: uppercase; }

  .cats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; }
  .cat { background: #fff; border: 1px solid var(--color-wr-border); padding: 1.75rem; text-decoration: none; color: inherit; transition: box-shadow .2s, transform .2s; display: flex; flex-direction: column; gap: .5rem; }
  .cat:hover { box-shadow: 0 8px 24px rgba(0,0,0,.08); transform: translateY(-2px); }
  .ico { color: #8A5D00; }
  .cat h3 { font-size: 1.25rem; text-transform: uppercase; letter-spacing: .04em; margin-top: .75rem; }
  .cat p { font-size: .9rem; color: var(--color-wr-muted); line-height: 1.6; flex: 1; }
  .more { font-family: var(--font-heading); font-size: .8rem; letter-spacing: .1em; text-transform: uppercase; color: #8A5D00; margin-top: .75rem; }

  .why { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
  .visual { position: relative; aspect-ratio: 4/3; background: #fff; border: 1px solid var(--color-wr-border); display: grid; place-items: center; color: #b7bcb7; }
  .badge { position: absolute; right: -1rem; bottom: -1.25rem; background: var(--color-wr-yellow); color: #121212; padding: 1rem 1.5rem; text-align: center; }
  .badge strong { display: block; font-family: var(--font-heading); font-size: 2rem; line-height: 1; }
  .badge small { font-family: var(--font-heading); font-size: .65rem; letter-spacing: .15em; text-transform: uppercase; }

  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .areas { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
  .chips { display: flex; flex-wrap: wrap; gap: .6rem; }

  @media (max-width: 960px) {
    .hero-inner, .why, .areas { grid-template-columns: 1fr; gap: 2.5rem; }
    .tiles { display: none; }
    .hero-inner { padding-top: 4rem; padding-bottom: 4rem; }
    .cats { grid-template-columns: 1fr 1fr; }
    .grid { grid-template-columns: 1fr 1fr; }
    .stats-grid { grid-template-columns: 1fr 1fr; }
    .badge { right: 0; }
  }
  @media (max-width: 600px) { .cats, .grid { grid-template-columns: 1fr; } }
</style>
