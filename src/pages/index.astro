---
import Layout from '../layouts/Layout.astro';
import { categories, items } from '../data/equipment';
import { AVAILABILITY_ON } from '../lib/config';
import { site, featuredCities } from '../data/site';
import { money } from '../lib/pricing';
import { itemImg, catImg, IMG } from '../lib/images';
import { photo } from '../lib/photo';

// Six picks for the "All" tab; each category tab shows its own items.
const featuredSlugs = ['mini-excavator-35', 'dump-truck-10yd', 'skid-steer', 'excavator-20t', 'compact-track-loader', 'flatbed-trailer-20'];
const steps = [
  ['Pick your equipment', 'Browse the fleet and add what you need. Rates are right there on every item.'],
  ['Choose your dates', 'Set your dates once and see estimated pricing and what is open, then pick up or get it delivered.'],
  ['We confirm', 'Our team checks availability and confirms your total, usually within one business day.'],
];
const industries = [
  ['Contractors', 'Excavators, trucks and compaction on your schedule, by the day, week or month.', IMG.contractors, '/equipment/excavation', 'Excavation rentals'],
  ['Landscapers', 'Compact loaders, grinders and trenchers that fit gates and finished yards.', IMG.landscapers, '/equipment/landscaping', 'Landscaping rentals'],
  ['Homeowners & property managers', 'Backyard projects, drainage and cleanup without buying the machine.', IMG.homeowners, '/equipment', 'Browse equipment'],
];
const heroP = await photo(IMG.hero, 2000);
const tileP = Object.fromEntries(await Promise.all(items.map(async (i) => [i.slug, await photo(itemImg(i.slug), 420)])));
const catP = Object.fromEntries(await Promise.all(categories.map(async (c) => [c.slug, await photo(catImg(c.slug), 600)])));
const aboutP = await photo(IMG.about, 700);
const indP = await Promise.all(industries.map((x) => photo(x[2], 640)));
const yardP = await photo(IMG.yard, 1600);
---
<Layout title="West Ridge Rentals | Truck & Equipment Rentals in Utah" description="Rent dump trucks, excavators, skid steers and landscaping equipment across Utah. See rates, set your dates and request your rental online.">
  <!-- Hero -->
  <section class="hero">
    <img class="hero-img" src={heroP.src} srcset={heroP.srcset} sizes="100vw" alt="Yellow excavator with its operator digging on a mountain job site" width={heroP.width} height={heroP.height} fetchpriority="high" decoding="async" />
    <div class="hero-shade"></div>
    <div class="container hero-inner">
      <p class="eyebrow eyebrow-light">Equipment rentals across Utah</p>
      <h1>Rent heavy equipment<br />for any job</h1>
      <p class="sub">Trucks, excavators and landscaping equipment for contractors and homeowners. Clear rates{AVAILABILITY_ON ? ', live availability' : ''} and one simple request.</p>
      <div class="actions">
        <a href="/request" class="btn-primary">Request a rental</a>
        <a href="/equipment" class="btn-glass">Browse equipment</a>
      </div>
    </div>
  </section>

  <!-- Finder sheet (overlaps the hero) -->
  <section class="finder">
    <div class="container finder-grid">
      <div class="finder-side">
        <h2 class="h2">Find the right equipment <span>for your next project</span></h2>
        <form id="finder-form" class="date-form">
          <div><label class="label" for="f-start">Start date</label><input class="field" type="date" id="f-start" required /></div>
          <div><label class="label" for="f-end">Return date</label><input class="field" type="date" id="f-end" required /></div>
          <button type="submit" class="btn-primary">{AVAILABILITY_ON ? 'Check availability & pricing' : 'See pricing for my dates'}</button>
          <p class="hint">{AVAILABILITY_ON ? "See what's open and your estimated total." : 'See your estimated total for those dates.'} No payment now.</p>
        </form>
      </div>

      <div class="finder-main">
        <div class="tabs" role="group" aria-label="Equipment categories">
          <button class="tab" data-tab="all" aria-pressed="true">Popular</button>
          {categories.map((c) => <button class="tab" data-tab={c.slug} aria-pressed="false">{c.name}</button>)}
          <a href="/equipment" class="viewall">View all equipment &rarr;</a>
        </div>
        <div class="tiles">
          {items.map((i) => (
            <a href={`/equipment/${i.category}/${i.slug}`} class="tile" data-cat={i.category} data-featured={featuredSlugs.includes(i.slug) ? '1' : '0'}>
              <span class="tile-img"><img src={tileP[i.slug].src} srcset={tileP[i.slug].srcset} sizes="(max-width: 640px) 45vw, 280px" alt={`${i.name} for rent`} width={tileP[i.slug].width} height={tileP[i.slug].height} loading="lazy" decoding="async" /></span>
              <span class="tile-name">{i.name}</span>
              <span class="tile-meta">From <strong>{money(i.rates[0])}</strong>/day</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Orange strip -->
  <div class="strip">
    <div class="container strip-inner">
      <span>Serving contractors and homeowners across Utah</span>
      <span>Day, week and month rates</span>
      <span>Delivery or pickup</span>
    </div>
  </div>

  <!-- Categories -->
  <section class="section section-gray">
    <div class="container">
      <div class="head">
        <div><p class="eyebrow">What we rent</p><h2 class="h2">Everything you need, one call away</h2></div>
        <a href="/equipment" class="btn-outline">View all equipment</a>
      </div>
      <div class="cats">
        {categories.map((c) => (
          <a href={`/equipment/${c.slug}`} class="cat">
            <img src={catP[c.slug].src} srcset={catP[c.slug].srcset} sizes="(max-width: 640px) 92vw, 300px" alt={`${c.name} rentals`} width={catP[c.slug].width} height={catP[c.slug].height} loading="lazy" decoding="async" />
            <span class="cat-shade"></span>
            <span class="cat-body"><strong>{c.name}</strong><em>{c.blurb}</em><b>Explore &rarr;</b></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="section section-white">
    <div class="container about">
      <div>
        <p class="eyebrow">Why West Ridge</p>
        <h2 class="h2" style="margin-bottom: 1.25rem;">Heavy machinery, without the runaround</h2>
        <p class="lead" style="margin-bottom: 1rem;">Tell us what you need and when. Our team checks availability, confirms pricing and arranges delivery so you can stay on the job.</p>
        <ul class="check-list" style="margin: 1.5rem 0 2rem;">
          <li><span><strong>Rates you can see.</strong> Day, week and month pricing on every item.</span></li>
          {AVAILABILITY_ON
            ? <li><span><strong>Live availability.</strong> Booked dates are blocked, so you only request what is open.</span></li>
            : <li><span><strong>Flexible rentals.</strong> By the day, week or month, with pickup or delivery.</span></li>}
          <li><span><strong>Maintained equipment.</strong> Inspected between every rental.</span></li>
        </ul>
        <div class="pills">
          <span class="pill"><strong>{items.length}+</strong><span>Machines</span></span>
          <span class="pill"><strong>Utah</strong><span>Statewide</span></span>
          <span class="pill"><strong>1 day</strong><span>Typical reply</span></span>
        </div>
      </div>
      <div class="about-photo"><img src={aboutP.src} srcset={aboutP.srcset} sizes="(max-width: 1000px) 92vw, 520px" alt="Two crew members in hi-vis vests overlooking an excavation site" width={aboutP.width} height={aboutP.height} loading="lazy" decoding="async" /></div>
    </div>
  </section>

  <!-- Best match -->
  <section class="section section-dark match">
    <div class="container">
      <div style="max-width: 34rem; margin-bottom: 3rem;">
        <p class="eyebrow eyebrow-light">Built for every crew</p>
        <h2 class="h2" style="color: #fff; margin-bottom: 1rem;">The best match for every job</h2>
        <p style="color: #b7bcc2; line-height: 1.7;">Whether you run a crew or you're tackling a weekend project, we have equipment sized for the work.</p>
      </div>
      <div class="industries">
        {industries.map(([t, d, img, href, cta], n) => (
          <a href={href} class="ind">
            <span class="ind-img"><img src={indP[n].src} srcset={indP[n].srcset} sizes="(max-width: 1000px) 92vw, 380px" alt={t} width={indP[n].width} height={indP[n].height} loading="lazy" decoding="async" /></span>
            <strong>{t}</strong>
            <span>{d}</span>
            <b>{cta} &rarr;</b>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section section-gray">
    <div class="container">
      <div style="text-align: center; margin-bottom: 3rem;"><p class="eyebrow">How it works</p><h2 class="h2">Request in three steps</h2></div>
      <div class="steps">
        {steps.map(([t, d], i) => (
          <div class="step"><span class="num">{i + 1}</span><h3>{t}</h3><p>{d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <img src={yardP.src} srcset={yardP.srcset} sizes="100vw" alt="" width={yardP.width} height={yardP.height} loading="lazy" decoding="async" />
    <div class="cta-shade"></div>
    <div class="container cta-inner">
      <div>
        <h2>Ready when you are</h2>
        <p>Send a request or call us and we'll confirm availability within one business day.</p>
        <div class="chips">{featuredCities.slice(0, 6).map((c) => <span class="chip-d">{c}</span>)}<a href="/service-areas" class="chip-d more">All service areas &rarr;</a></div>
      </div>
      <div class="cta-actions">
        <a href="/request" class="btn-primary">Request a rental</a>
        <a href={site.phoneHref} class="btn-outline-light">Call {site.phone}</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero { position: relative; min-height: 600px; display: flex; align-items: center; color: #fff; background: var(--color-wr-ink); overflow: hidden; }
  .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; }
  .hero-shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(15,17,19,.82) 0%, rgba(15,17,19,.5) 45%, rgba(15,17,19,.08) 75%), linear-gradient(180deg, rgba(15,17,19,.25) 0%, rgba(15,17,19,0) 40%, rgba(15,17,19,.55) 100%); }
  .hero-inner { position: relative; padding-top: 5rem; padding-bottom: 9rem; }
  .hero h1 { font-size: clamp(2.6rem, 7vw, 5rem); font-weight: 800; text-transform: uppercase; line-height: .98; color: #fff; max-width: 46rem; margin-bottom: 1.4rem; letter-spacing: -.025em; }
  .sub { color: #d9dce0; font-size: 1.1rem; line-height: 1.7; max-width: 34rem; margin-bottom: 2rem; }
  .actions { display: flex; gap: .75rem; flex-wrap: wrap; }

  /* Finder */
  .finder { position: relative; z-index: 2; background: var(--color-wr-white); border-radius: 32px 32px 0 0; margin-top: -4.5rem; padding: 3.25rem 0 3.5rem; }
  .finder-grid { display: grid; grid-template-columns: 300px 1fr; gap: 3rem; align-items: start; }
  .finder-side .h2 { font-size: clamp(1.7rem, 3vw, 2.15rem); margin-bottom: 1.5rem; }
  .finder-side .h2 span { color: #9aa0a6; }
  .date-form { display: grid; gap: .85rem; }
  .date-form .btn-primary { margin-top: .25rem; }
  .hint { font-size: .8rem; color: var(--color-wr-muted); }
  .tabs { display: flex; flex-wrap: wrap; gap: .4rem 1.35rem; align-items: center; margin-bottom: 1.25rem; }
  .tab { font-size: .92rem; font-weight: 600; color: var(--color-wr-muted); padding: .35rem 0; border-bottom: 2px solid transparent; transition: color .15s; }
  .tab:hover { color: var(--color-wr-ink); }
  .tab[aria-pressed="true"] { color: var(--color-wr-ink); border-bottom-color: var(--color-wr-accent); }
  .viewall { margin-left: auto; font-size: .9rem; font-weight: 600; color: var(--color-wr-amber); text-decoration: none; }
  .viewall:hover { text-decoration: underline; }
  .tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .tile { display: flex; flex-direction: column; gap: .15rem; text-decoration: none; color: inherit; }
  .tile.hidden { display: none; }
  .tile-img { display: block; aspect-ratio: 4/3; border-radius: 18px; overflow: hidden; background: var(--color-wr-mid); margin-bottom: .55rem; }
  .tile-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .45s ease; }
  .tile:hover .tile-img img { transform: scale(1.05); }
  .tile-name { font-weight: 700; font-size: .98rem; }
  .tile-meta { font-size: .85rem; color: var(--color-wr-muted); }
  .tile-meta strong { color: var(--color-wr-ink); }

  /* Orange strip */
  .strip { background: var(--color-wr-accent); color: #fff; }
  .strip-inner { display: flex; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; padding-top: .95rem; padding-bottom: .95rem; font-weight: 600; font-size: .95rem; }

  /* Categories */
  .head { display: flex; justify-content: space-between; align-items: flex-end; gap: 1.5rem; flex-wrap: wrap; margin-bottom: 2.5rem; }
  .cats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.1rem; }
  .cat { position: relative; display: block; aspect-ratio: 4/5; border-radius: 22px; overflow: hidden; color: #fff; text-decoration: none; background: var(--color-wr-char); }
  .cat img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease; }
  .cat:hover img { transform: scale(1.06); }
  .cat-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(15,17,19,0) 35%, rgba(15,17,19,.88) 100%); }
  .cat-body { position: absolute; left: 0; right: 0; bottom: 0; padding: 1.4rem; display: grid; gap: .35rem; }
  .cat-body strong { font-family: var(--font-heading); font-size: 1.35rem; font-weight: 800; line-height: 1.1; }
  .cat-body em { font-style: normal; font-size: .85rem; color: #d3d6da; line-height: 1.45; }
  .cat-body b { font-size: .85rem; color: var(--color-wr-accent-light); margin-top: .3rem; }

  /* About */
  .about { display: grid; grid-template-columns: 1.1fr .9fr; gap: 4.5rem; align-items: center; }
  .pills { display: flex; flex-wrap: wrap; gap: .75rem; }
  .about-photo { border-radius: 26px; overflow: hidden; aspect-ratio: 9/11; box-shadow: 0 24px 50px rgba(15,17,19,.18); }
  .about-photo img { width: 100%; height: 100%; object-fit: cover; }

  /* Best match */
  .industries { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .ind { display: flex; flex-direction: column; gap: .5rem; text-decoration: none; color: #b7bcc2; background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1); border-radius: 22px; padding: .8rem .8rem 1.5rem; transition: background .2s, transform .2s; }
  .ind:hover { background: rgba(255,255,255,.09); transform: translateY(-3px); }
  .ind-img { display: block; aspect-ratio: 4/3; border-radius: 16px; overflow: hidden; margin-bottom: .75rem; }
  .ind-img img { width: 100%; height: 100%; object-fit: cover; }
  .ind strong { color: #fff; font-family: var(--font-heading); font-size: 1.3rem; font-weight: 800; padding: 0 .7rem; }
  .ind > span:not(.ind-img) { padding: 0 .7rem; font-size: .92rem; line-height: 1.6; }
  .ind b { padding: 0 .7rem; color: var(--color-wr-accent-light); font-size: .88rem; margin-top: .25rem; }

  /* Steps */
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .step { background: #fff; border: 1px solid var(--color-wr-border); border-radius: 22px; padding: 2rem; }
  .num { display: grid; place-items: center; width: 2.9rem; height: 2.9rem; border-radius: 50%; background: var(--color-wr-accent); color: #fff; font-family: var(--font-heading); font-weight: 800; font-size: 1.4rem; margin-bottom: 1.1rem; }
  .step h3 { font-size: 1.3rem; font-weight: 800; margin-bottom: .4rem; }
  .step p { color: var(--color-wr-muted); line-height: 1.65; }

  /* CTA */
  .cta { position: relative; color: #fff; background: var(--color-wr-ink); overflow: hidden; }
  .cta img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .cta-shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(15,17,19,.92), rgba(15,17,19,.7)); }
  .cta-inner { position: relative; display: flex; justify-content: space-between; align-items: center; gap: 2.5rem; flex-wrap: wrap; padding-top: 5rem; padding-bottom: 5rem; }
  .cta h2 { font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; color: #fff; margin-bottom: .75rem; }
  .cta p { color: #c9cdd2; max-width: 30rem; line-height: 1.65; margin-bottom: 1.25rem; }
  .chips { display: flex; flex-wrap: wrap; gap: .5rem; max-width: 34rem; }
  .chip-d { font-size: .8rem; padding: .35rem .85rem; border: 1px solid rgba(255,255,255,.3); border-radius: 999px; color: #e5e7ea; text-decoration: none; }
  .chip-d.more { color: var(--color-wr-accent-light); border-color: var(--color-wr-accent-light); }
  .cta-actions { display: flex; gap: .75rem; flex-wrap: wrap; }

  @media (max-width: 1000px) {
    .finder-grid { grid-template-columns: 1fr; gap: 2rem; }
    .cats { grid-template-columns: 1fr 1fr; }
    .about { grid-template-columns: 1fr; gap: 2.5rem; }
    .about-photo { aspect-ratio: 4/3; order: -1; }
    .industries, .steps { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .hero { min-height: 520px; }
    .hero-inner { padding-top: 3.5rem; padding-bottom: 7.5rem; }
    .finder { border-radius: 24px 24px 0 0; margin-top: -3.5rem; padding-top: 2.5rem; }
    .tiles { grid-template-columns: 1fr 1fr; gap: .8rem; }
    .viewall { margin-left: 0; flex-basis: 100%; }
    .cats { grid-template-columns: 1fr; }
    .cat { aspect-ratio: 16/11; }
    .strip-inner { flex-direction: column; gap: .3rem; font-size: .88rem; }
  }
</style>

<script>
  import { setDates } from '../lib/dates';
  import { todayKey } from '../lib/availability';

  // Finder tabs: "Popular" shows six picks, each category tab shows that category.
  const tabs = document.querySelectorAll<HTMLElement>('[data-tab]');
  const tiles = document.querySelectorAll<HTMLElement>('.tile');
  const show = (t: string) => {
    tiles.forEach((el) => el.classList.toggle('hidden', t === 'all' ? el.dataset.featured !== '1' : el.dataset.cat !== t));
    tabs.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tab === t)));
  };
  tabs.forEach((b) => b.addEventListener('click', () => show(b.dataset.tab!)));
  show('all');

  // Finder form: save dates, then jump to the equipment list with prices and availability for those dates.
  const s = document.getElementById('f-start') as HTMLInputElement;
  const e = document.getElementById('f-end') as HTMLInputElement;
  s.min = e.min = todayKey();
  s.addEventListener('change', () => { if (s.value) e.min = s.value; if (e.value && e.value < s.value) e.value = s.value; });
  document.getElementById('finder-form')!.addEventListener('submit', (ev) => {
    ev.preventDefault();
    if (s.value && e.value && e.value >= s.value) { setDates({ start: s.value, end: e.value }); location.href = '/equipment'; }
  });
</script>
