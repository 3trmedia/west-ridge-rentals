---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
---
<Layout title="Privacy Policy | West Ridge Rentals" description="How West Ridge Rentals collects and uses information submitted through this website.">
  <PageHero eyebrow="Legal" title="Privacy Policy" intro="Draft placeholder. Have this reviewed before launch." />
  <section class="section section-gray">
    <div class="container prose">
      <h2>What we collect</h2>
      <p>When you submit a rental request or contact form we collect the details you enter: name, company, phone, email, job site address, dates and notes.</p>
      <h2>How we use it</h2>
      <p>We use this information only to respond to your request, confirm availability and arrange your rental. We do not sell your information.</p>
      <h2>Form processing</h2>
      <p>Forms are delivered to our team by Web3Forms, a third-party form service, which passes your submission to us by email.</p>
      <h2>Your request list</h2>
      <p>The equipment list you build is saved in your own browser only and is not sent to us until you submit a request.</p>
      <h2>Contact</h2>
      <p>Questions? Email <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
    </div>
  </section>
</Layout>
<style is:global>
  .prose { max-width: 820px; }
  .prose h2 { font-size: 1.5rem; text-transform: uppercase; margin: 2rem 0 .5rem; }
  .prose h2:first-child { margin-top: 0; }
  .prose p { color: #333; line-height: 1.7; }
  .prose a { color: #8A5D00; text-decoration: underline; }
</style>
