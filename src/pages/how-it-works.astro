---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { IMG } from '../lib/images';
const steps = [
  ['Build your request list', 'Browse the fleet and tap "Add to request" on everything you need. Your list follows you around the site.'],
  ['Pick dates and delivery', 'Choose your start and return dates, then pickup at our yard or delivery to your job site. You will see an estimated total right away.'],
  ['Send it over', 'Add your contact info and submit. There is no payment and no commitment at this step.'],
  ['We confirm', 'Our team checks availability, confirms pricing and delivery, and gets back to you by phone or email.'],
  ['Pick up or get delivered', 'Sign the rental agreement, do a quick walk-around, and get to work.'],
];
const faqs = [
  ['Do I pay when I submit a request?', 'No. A request is not a booking. We confirm availability and pricing with you first.'],
  ['What do I need to rent?', 'Typically a valid ID, proof of insurance and a signed rental agreement. A deposit may apply. (Final requirements to be confirmed.)'],
  ['Do you deliver?', 'Yes, to most of Utah. Delivery is quoted based on distance and equipment.'],
  ['Can I rent with an operator?', 'Tell us in the notes on your request and we will let you know what is possible.'],
  ['How fast will I hear back?', 'We respond to every request within one business day.'],
  ['Can I change my dates?', 'Yes. Just call or email us and we will adjust if the equipment is available.'],
];
---
<Layout title="How Renting Works | West Ridge Rentals" description="Renting from West Ridge is simple: build a request, pick dates, and our team confirms availability and delivery.">
  <PageHero eyebrow="How it works" title="Five steps. No runaround." intro="From request to job site, here's what to expect." primary={['Start your request', '/equipment']} image={IMG.yard} alt="Equipment yard with loaders and lifts" />

  <section class="section section-gray">
    <div class="container narrow">
      <ol class="steps">
        {steps.map(([t, d], i) => (
          <li class="card">
            <span class="num">{i + 1}</span>
            <div><h3>{t}</h3><p>{d}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section-white">
    <div class="container">
      <div style="text-align: center; margin-bottom: 2.5rem;"><p class="eyebrow">Common questions</p><h2 class="h2">Rental FAQ</h2></div>
      <div class="faq">{faqs.map(([q, a]) => <div class="card card-accent" style="padding: 1.25rem 1.5rem;"><h3 class="q">{q}</h3><p class="a">{a}</p></div>)}</div>
    </div>
  </section>
</Layout>

<style>
  .narrow { max-width: 880px; }
  .steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; }
  .steps li { display: flex; gap: 1.5rem; padding: 1.6rem 1.75rem; align-items: flex-start; }
  .num { flex: none; display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 50%; background: var(--color-wr-accent); color: #fff; font-family: var(--font-heading); font-weight: 800; font-size: 1.4rem; }
  .steps h3 { font-size: 1.3rem; font-weight: 800; }
  .steps p { color: var(--color-wr-muted); margin-top: .3rem; line-height: 1.65; }
  .faq { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .q { font-family: var(--font-body); font-size: 1.02rem; font-weight: 700; letter-spacing: 0; margin-bottom: .4rem; }
  .a { font-size: .92rem; color: var(--color-wr-muted); line-height: 1.6; }
  @media (max-width: 800px) { .faq { grid-template-columns: 1fr; } }
</style>
