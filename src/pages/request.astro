---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { categories, items } from '../data/equipment';
import { site, featuredCities } from '../data/site';
const rateMap = Object.fromEntries(items.map((i) => [i.slug, i.rates]));
---
<Layout title="Request a Rental | West Ridge Rentals" description="Build your equipment rental request, choose dates and delivery, and send it to our team for confirmation." noindex>
  <PageHero eyebrow="Request a rental" kicker="Free rental quote in Utah" title="Get a rental quote" intro={`Pick your equipment and dates and we'll get back to you within one business day. No payment now. Our team confirms availability, pricing and delivery with you first.`} />

  <section class="section section-gray">
    <div class="container form-layout">
      <div>
        <div id="success" class="hidden success card">
          <p class="big">Request sent</p>
          <p>Thanks, we've got it. Our team will reach out shortly to confirm. Need it sooner? Call <a href={site.phoneHref}>{site.phone}</a>.</p>
          <p class="sum-title">Here's what you sent</p>
          <pre id="sent-summary" class="sum"></pre>
          <a href="/equipment" class="btn-outline" style="margin-top: 1.5rem;">Back to equipment</a>
        </div>

        <form id="form" class="form-card card" novalidate data-key={site.web3formsKey} data-site={site.name} data-rates={JSON.stringify(rateMap)}>
          <h2 class="form-title">Tell us what you need</h2>

          <div class="block">
            <label class="label" for="picker">Equipment *</label>
            <ul id="items" class="picked"></ul>
            <p id="items-empty" class="hidden hint">Nothing added yet. Choose equipment below or <a href="/equipment">browse the fleet</a>.</p>
            <div class="add-row">
              <select id="picker" class="field">
                <option value="">Add equipment...</option>
                {categories.map((c) => (
                  <optgroup label={c.name}>
                    {items.filter((i) => i.category === c.slug).map((i) => <option value={i.slug}>{i.name}</option>)}
                  </optgroup>
                ))}
              </select>
              <button type="button" id="add-btn" class="btn-outline">Add</button>
            </div>
          </div>

          <div class="two">
            <div><label class="label" for="start">Start date *</label><input class="field" type="date" id="start" required /></div>
            <div><label class="label" for="end">Return date *</label><input class="field" type="date" id="end" required /></div>
          </div>
          <div class="lens" id="lens" aria-label="Quick rental length">
            <span>Quick pick:</span>
            <button type="button" data-len="1">1 day</button><button type="button" data-len="3">3 days</button><button type="button" data-len="7">1 week</button><button type="button" data-len="14">2 weeks</button><button type="button" data-len="30">1 month</button>
          </div>
          <p id="duration" class="duration"></p>
          <p id="date-error" class="hidden err"></p>
          <div id="avail-warn" class="hidden warn" role="alert"></div>
          <div id="estimate" class="hidden est" aria-live="polite"></div>

          <div class="block">
            <span class="label">Delivery or pickup *</span>
            <div class="two" role="radiogroup">
              <label class="opt"><input type="radio" name="method" value="Pickup" checked /><span><strong>I'll pick it up</strong><small>Yard address sent with your confirmation</small></span></label>
              <label class="opt"><input type="radio" name="method" value="Delivery" /><span><strong>Deliver to my site</strong><small>We'll quote delivery</small></span></label>
            </div>
            <div id="address-wrap" class="hidden" style="margin-top: 1rem;">
              <label class="label" for="address">Job site address *</label>
              <input class="field" id="address" placeholder="1234 Main St, Provo, UT 84601" autocomplete="street-address" />
            </div>
          </div>

          <div class="two">
            <div><label class="label" for="name">Name *</label><input class="field" id="name" placeholder="John Smith" autocomplete="name" required /></div>
            <div><label class="label" for="company">Company</label><input class="field" id="company" placeholder="Company name" autocomplete="organization" /></div>
          </div>
          <div class="two">
            <div><label class="label" for="phone">Phone number *</label><input class="field" id="phone" type="tel" placeholder="(801) 555-0100" autocomplete="tel" required /></div>
            <div><label class="label" for="email">Email address *</label><input class="field" id="email" type="email" placeholder="you@example.com" autocomplete="email" required /></div>
          </div>
          <div class="block">
            <label class="label" for="notes">Project details</label>
            <textarea class="field" id="notes" rows="4" placeholder="Describe the job, whether you need an operator, attachments, anything else..."></textarea>
          </div>

          <input type="checkbox" id="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
          <p id="form-error" class="hidden err"></p>
          <button type="submit" id="submit" class="btn-primary" style="width: 100%;">Submit rental request</button>
          <p class="fine">By sending, you agree we may contact you about this request. See our <a href="/privacy">Privacy Policy</a>.</p>
        </form>
      </div>

      <aside class="side">
        <div class="card info">
          <h3>Contact information</h3>
          <dl>
            <div><dt>Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
            <div><dt>Phone</dt><dd><a href={site.phoneHref}>{site.phone}</a></dd></div>
            <div><dt>Location</dt><dd>{site.address}</dd></div>
            <div><dt>Hours</dt><dd>{site.hours}</dd></div>
          </dl>
        </div>
        <div class="card info">
          <h3>Service area</h3>
          <p class="hint">We deliver to job sites across the state of Utah.</p>
          <div class="chips">{featuredCities.slice(0, 8).map((c) => <span class="chip">{c}</span>)}</div>
          <a href="/service-areas" class="more">View all service areas &rarr;</a>
        </div>
        <div class="guarantee"><strong>One-business-day response</strong><span>We reply to every rental request within one business day.</span></div>
      </aside>
    </div>
  </section>
</Layout>

<style is:global>
  /* Rows below are created by the script, so these rules are global. */
  .picked { list-style: none; padding: 0; margin: 0 0 .75rem; display: grid; gap: .5rem; }
  .picked li { display: flex; align-items: center; justify-content: space-between; gap: .75rem; background: #fff; border: 1px solid var(--color-wr-border); border-left: 4px solid var(--color-wr-accent); border-radius: 12px; padding: .7rem .95rem; }
  .picked .name { font-weight: 600; }
  .row-rate { display: block; font-weight: 400; color: var(--color-wr-muted); font-size: .8rem; }
  .rm { font-size: .82rem; color: var(--color-wr-muted); }
  .rm:hover { color: #b3261e; text-decoration: underline; }
  .add-row { display: flex; gap: .6rem; }
  .add-row .btn-outline { padding: .8rem 1.4rem; }
  .duration { color: var(--color-wr-amber); font-weight: 600; min-height: 1.2rem; margin: -.5rem 0 1rem; font-size: .9rem; }
  .lens { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem; margin: -.25rem 0 1rem; font-size: .85rem; color: var(--color-wr-muted); }
  .lens button { font-size: .82rem; font-weight: 600; padding: .35rem .85rem; border: 1px solid var(--color-wr-border); background: #fff; border-radius: 999px; color: var(--color-wr-ink); }
  .lens button:hover { border-color: var(--color-wr-ink); }
  .est { background: #fff; border: 1px solid var(--color-wr-border); border-left: 4px solid var(--color-wr-accent); border-radius: 14px; padding: 1rem 1.25rem; margin-bottom: 1.25rem; }
  .est-title { font-size: .72rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--color-wr-amber); margin-bottom: .5rem; }
  .est ul { list-style: none; padding: 0; margin: 0 0 .5rem; display: grid; gap: .3rem; font-size: .92rem; }
  .est li { display: flex; justify-content: space-between; gap: 1rem; }
  .est-total { display: flex; justify-content: space-between; align-items: baseline; border-top: 1px solid var(--color-wr-border); padding-top: .6rem; }
  .est-total span { font-weight: 700; }
  .est-total strong { font-family: var(--font-heading); font-weight: 800; font-size: 1.9rem; line-height: 1; }
  .est-note { font-size: .75rem; color: var(--color-wr-muted); margin-top: .5rem; line-height: 1.5; }
  .warn { background: #FFF4E5; border: 1px solid #E8A33D; border-left: 4px solid #E8A33D; border-radius: 12px; padding: .9rem 1.1rem; margin-bottom: 1.25rem; font-size: .92rem; color: #4a3200; }
  .warn ul { margin: .5rem 0 0 1.1rem; list-style: disc; display: grid; gap: .3rem; }
  .opt { display: flex; gap: .75rem; align-items: flex-start; padding: .9rem 1rem; background: #fff; border: 1px solid var(--color-wr-border); border-radius: 12px; cursor: pointer; }
  .opt:has(input:checked) { border-color: var(--color-wr-accent); box-shadow: inset 0 0 0 1px var(--color-wr-accent); background: #FFF7EE; }
  .opt input { accent-color: var(--color-wr-ink); margin-top: .3rem; }
  .opt small { display: block; color: var(--color-wr-muted); }
  .success { padding: 2.25rem; border-color: var(--color-wr-accent); }
  .success .big { font-family: var(--font-heading); font-size: 2rem; font-weight: 800; margin-bottom: .5rem; }
  .success a:not(.btn-outline) { color: var(--color-wr-amber); text-decoration: underline; }
  .sum-title { font-size: .72rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--color-wr-amber); margin-top: 1.5rem; }
  .sum { white-space: pre-wrap; font-family: var(--font-body); font-size: .9rem; background: var(--color-wr-bg); border: 1px solid var(--color-wr-border); border-radius: 12px; padding: 1rem 1.25rem; margin-top: .5rem; line-height: 1.6; }
</style>

<script>
  import { loadAvailability, conflicts, nextFree, fmtRange, fmt, daysBetween, addDays, todayKey } from '../lib/availability';
  import type { Availability } from '../lib/availability';
  import { getDates, setDates } from '../lib/dates';
  import { estimate, money, type Rates } from '../lib/pricing';
  import { getList, saveList, addToList } from '../lib/request-list';

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const form = $<HTMLFormElement>('form'), success = $('success'), itemsEl = $('items'), picker = $<HTMLSelectElement>('picker');
  const start = $<HTMLInputElement>('start'), end = $<HTMLInputElement>('end');
  const key = form.dataset.key!, siteName = form.dataset.site!;
  const rates: Record<string, Rates> = JSON.parse(form.dataset.rates || '{}');
  let avail: Availability = { ok: false, bookings: {} };
  const today = todayKey(); // Utah calendar day, same as the rest of the site
  start.min = end.min = today;

  const render = () => {
    const list = getList();
    $('items-empty').classList.toggle('hidden', list.length > 0);
    itemsEl.innerHTML = '';
    list.forEach((e) => {
      const li = document.createElement('li');
      const name = document.createElement('span'); name.className = 'name'; name.textContent = e.name;
      if (rates[e.slug]) { const r = document.createElement('small'); r.className = 'row-rate'; r.textContent = money(rates[e.slug][0]) + '/day'; name.appendChild(r); }
      const rm = document.createElement('button'); rm.type = 'button'; rm.className = 'rm'; rm.textContent = 'Remove';
      rm.addEventListener('click', () => { saveList(getList().filter((x) => x.slug !== e.slug)); refresh(); });
      li.append(name, rm);
      itemsEl.appendChild(li);
    });
  };

  $('add-btn').addEventListener('click', () => {
    if (!picker.value) return;
    addToList(picker.value, picker.options[picker.selectedIndex].text);
    picker.value = ''; refresh();
  });

  const rentalDays = () => (start.value && end.value && end.value >= start.value ? daysBetween(start.value, end.value) + 1 : 0);

  // Live price estimate from the listed rates (cheapest day/week/month mix), before delivery, fuel and tax.
  const priceLines = () => {
    const days = rentalDays();
    if (!days) return null;
    const lines = getList().filter((e) => rates[e.slug]).map((e) => ({ name: e.name, cost: estimate(rates[e.slug], days) }));
    return { days, lines, total: lines.reduce((n, l) => n + l.cost, 0) };
  };
  const renderEstimate = () => {
    const box = $('estimate'); const p = priceLines();
    if (!p || !p.lines.length) { box.classList.add('hidden'); box.innerHTML = ''; return; }
    box.innerHTML = `<p class="est-title">Estimated total for ${p.days} day${p.days === 1 ? '' : 's'}</p><ul>${p.lines.map((l) => `<li><span></span><b>${money(l.cost)}</b></li>`).join('')}</ul><p class="est-total"><span>Estimate</span><strong>${money(p.total)}</strong></p><p class="est-note">Based on our listed rates, before delivery, fuel and tax. Weekly and monthly rates are applied automatically. We confirm your final total before anything is booked.</p>`;
    box.querySelectorAll('li span').forEach((el, i) => { el.textContent = p.lines[i].name; });
    box.classList.remove('hidden');
  };

  // Equipment already booked for the chosen dates (from the bookings calendar). Returns true if there are none.
  const checkConflicts = () => {
    const box = $('avail-warn'); box.classList.add('hidden'); box.innerHTML = '';
    if (!avail.ok || !rentalDays()) return true;
    const len = rentalDays();
    const hits = getList().map((e) => ({ e, c: conflicts(avail, e.slug, start.value, end.value) })).filter((x) => x.c.length);
    if (!hits.length) return true;
    box.innerHTML = '<p><strong>Some equipment is already booked for those dates.</strong> Please pick different dates or remove it from your list.</p><ul></ul>';
    const ul = box.querySelector('ul')!;
    hits.forEach(({ e, c }) => {
      const li = document.createElement('li');
      const b = document.createElement('strong'); b.textContent = e.name;
      li.append(b, ` is booked ${c.map(fmtRange).join(', ')}. Next open for your ${len} day${len === 1 ? '' : 's'}: ${fmt(nextFree(avail, e.slug, start.value, len))}.`);
      ul.appendChild(li);
    });
    box.classList.remove('hidden');
    return false;
  };

  // Shows the day count and any date problem. Returns true when the dates are usable.
  const validateDates = () => {
    const err = $('date-error'), dur = $('duration');
    err.classList.add('hidden'); dur.textContent = '';
    if (start.value) end.min = start.value;
    let ok = true;
    if (start.value && start.value < today) { err.textContent = 'Start date can’t be in the past.'; ok = false; }
    else if (start.value && end.value && end.value < start.value) { err.textContent = 'Return date must be on or after the start date.'; ok = false; }
    if (!ok) err.classList.remove('hidden');
    else if (rentalDays()) dur.textContent = `${rentalDays()} rental day${rentalDays() === 1 ? '' : 's'}`;
    return ok;
  };

  const refresh = () => { render(); validateDates(); renderEstimate(); checkConflicts(); };
  const saveDates = () => { if (validateDates() && rentalDays()) setDates({ start: start.value, end: end.value }); };
  start.addEventListener('change', () => { if (end.value && end.value < start.value) end.value = start.value; refresh(); saveDates(); });
  end.addEventListener('change', () => { refresh(); saveDates(); });
  $('lens').addEventListener('click', (ev) => {
    const len = Number((ev.target as HTMLElement).dataset?.len);
    if (!len) return;
    if (!start.value || start.value < today) start.value = today;
    end.value = addDays(start.value, len - 1);
    refresh(); saveDates();
  });

  document.querySelectorAll<HTMLInputElement>('input[name="method"]').forEach((r) => r.addEventListener('change', () => {
    $('address-wrap').classList.toggle('hidden', document.querySelector<HTMLInputElement>('input[name="method"]:checked')!.value !== 'Delivery');
  }));

  form.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const fe = $('form-error'); fe.classList.add('hidden');
    const fail = (m: string) => { fe.textContent = m; fe.classList.remove('hidden'); };
    const val = (id: string) => $<HTMLInputElement>(id).value.trim();
    const list = getList();
    const method = document.querySelector<HTMLInputElement>('input[name="method"]:checked')!.value;
    if (!list.length) return fail('Please add at least one piece of equipment.');
    if (!start.value || !end.value || !validateDates()) return fail('Please choose valid start and return dates.');
    if (!checkConflicts()) return fail('Some equipment is booked for those dates. Please adjust your dates or list.');
    if (method === 'Delivery' && !val('address')) return fail('Please enter the job site address for delivery.');
    const email = $<HTMLInputElement>('email');
    if (!val('name') || !val('phone') || !email.value || !email.validity.valid) return fail('Please add your name, phone and a valid email.');

    const days = rentalDays();
    const p = priceLines();
    const message = [
      'EQUIPMENT REQUESTED', ...list.map((e) => `  - ${e.name}`), '',
      `DATES: ${start.value} to ${end.value} (${days} day${days === 1 ? '' : 's'})`,
      ...(p ? [`ESTIMATE (listed rates, before delivery/fuel/tax): ${money(p.total)}`, ...p.lines.map((l) => `  - ${l.name}: ${money(l.cost)}`)] : []),
      `METHOD: ${method}${method === 'Delivery' ? ' to ' + val('address') : ''}`, '',
      `COMPANY: ${val('company') || 'n/a'}`,
      `NOTES: ${val('notes') || 'none'}`,
    ].join('\n');

    const btn = $<HTMLButtonElement>('submit'); btn.disabled = true; btn.textContent = 'Sending...';
    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          access_key: key,
          subject: `Rental request from ${val('name')}${val('company') ? ' (' + val('company') + ')' : ''}`,
          from_name: siteName,
          name: val('name'), email: val('email'), phone: val('phone'),
          message, botcheck: $<HTMLInputElement>('botcheck').checked,
        }),
      });
      const data = await res.json();
      if (!data.success) throw new Error(data.message || 'failed');
      try { localStorage.setItem('wr-contact', JSON.stringify({ name: val('name'), company: val('company'), phone: val('phone'), email: val('email') })); } catch {}
      $('sent-summary').textContent = message;
      saveList([]); form.classList.add('hidden'); success.classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } catch {
      fail('Something went wrong sending your request. Please try again or call us.');
      btn.disabled = false; btn.textContent = 'Submit rental request';
    }
  });

  // Remembered from earlier browsing (dates) and from a previous request (contact details).
  const sd = getDates(); if (sd) { start.value = sd.start; end.value = sd.end; }
  try {
    const c = JSON.parse(localStorage.getItem('wr-contact') || 'null');
    if (c) for (const k of ['name', 'company', 'phone', 'email']) $<HTMLInputElement>(k).value = c[k] || '';
  } catch {}
  refresh();
  loadAvailability().then((a) => { avail = a; checkConflicts(); });
</script>
