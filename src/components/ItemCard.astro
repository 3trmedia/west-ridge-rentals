---
import { catName, type Item } from '../data/equipment';
import { money } from '../lib/pricing';
import { itemImg } from '../lib/images';
import { photo } from '../lib/photo';
const { item } = Astro.props as { item: Item };
const href = `/equipment/${item.category}/${item.slug}`;
const p = await photo(itemImg(item.slug), 480);
---
<article class="item-card" data-item-card data-slug={item.slug} data-name={item.name.toLowerCase()} data-category={item.category} data-rates={item.rates.join(',')}>
  <a href={href} class="thumb" tabindex="-1" aria-label={item.name}>
    <img src={p.src} srcset={p.srcset} sizes="(max-width: 640px) 92vw, 320px" alt={`${item.name} available to rent in Utah`} width={p.width} height={p.height} loading="lazy" decoding="async" />
    <span class="tag">{catName(item.category)}</span>
    <span class="booked-pill" data-avail-slot data-slug={item.slug} hidden></span>
  </a>
  <div class="body">
    <h3><a href={href}>{item.name}</a></h3>
    <p class="meta">{item.blurb}</p>
    <ul class="specs">{item.specs.slice(0, 2).map(([k, v]) => <li><span>{k}</span>{v}</li>)}</ul>
    <p class="est-line" data-est hidden></p>
    <div class="foot">
      <div class="price"><span><strong>{money(item.rates[0])}</strong>/day</span><small>{money(item.rates[1])}/wk &middot; {money(item.rates[2])}/mo</small></div>
      <button type="button" class="btn-primary add" data-add data-slug={item.slug} data-name={item.name}><span data-add-label>Add to request</span></button>
    </div>
  </div>
</article>

<style>
  .item-card { background: #fff; border: 1px solid var(--color-wr-border); border-radius: var(--radius-card); overflow: hidden; display: flex; flex-direction: column; transition: box-shadow .2s, transform .2s; }
  .item-card:hover { box-shadow: 0 14px 34px rgba(15,17,19,.12); transform: translateY(-3px); }
  .item-card.hidden { display: none; }
  :global(.item-card.unavail) { opacity: .62; }
  .thumb { position: relative; display: block; aspect-ratio: 4/3; background: var(--color-wr-mid); overflow: hidden; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
  .item-card:hover .thumb img { transform: scale(1.04); }
  .tag { position: absolute; top: .75rem; left: .75rem; background: rgba(255,255,255,.94); color: var(--color-wr-ink); font-size: .68rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; padding: .3rem .65rem; border-radius: 999px; }
  .booked-pill { position: absolute; left: .75rem; bottom: .75rem; background: var(--color-wr-ink); color: #fff; font-size: .72rem; font-weight: 600; padding: .3rem .7rem; border-radius: 999px; }
  .body { padding: 1.1rem 1.15rem 1.2rem; display: flex; flex-direction: column; gap: .5rem; flex: 1; }
  h3 { font-size: 1.2rem; font-weight: 700; line-height: 1.15; }
  h3 a { color: var(--color-wr-ink); text-decoration: none; }
  h3 a:hover { color: var(--color-wr-amber); }
  .meta { font-size: .85rem; color: var(--color-wr-muted); line-height: 1.5; }
  .specs { list-style: none; padding: 0; margin: 0; flex: 1; display: grid; gap: .15rem; font-size: .8rem; color: #333; }
  .specs span { color: var(--color-wr-muted); margin-right: .4rem; }
  .specs span::after { content: ':'; }
  .est-line { font-size: .8rem; font-weight: 600; color: var(--color-wr-amber); background: #F6EAE2; padding: .4rem .7rem; border-radius: 10px; }
  .est-line.bad { color: #7a2a00; background: #FDE8D8; }
  .foot { display: flex; align-items: center; justify-content: space-between; gap: .75rem; padding-top: .6rem; border-top: 1px solid var(--color-wr-border); margin-top: .35rem; }
  .price { display: flex; flex-direction: column; line-height: 1.25; font-size: .8rem; color: #444; }
  .price strong { font-family: var(--font-heading); font-size: 1.5rem; font-weight: 800; color: var(--color-wr-ink); }
  .price small { color: var(--color-wr-muted); font-size: .72rem; }
  .add { flex: none; width: 7.6rem; padding: .6rem .5rem; font-size: .8rem; }
</style>
