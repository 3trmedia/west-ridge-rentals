---
import Icon from './Icon.astro';
import { categories, catName, type Item } from '../data/equipment';
import { money } from '../lib/pricing';
const { item } = Astro.props as { item: Item };
const icon = categories.find((c) => c.slug === item.category)?.icon ?? 'truck';
const href = `/equipment/${item.category}/${item.slug}`;
---
<article class="item-card" data-item-card data-slug={item.slug} data-name={item.name.toLowerCase()} data-category={item.category} data-rates={item.rates.join(',')}>
  <a href={href} class="thumb">
    <Icon name={icon} class="w-14 h-14" />
    <span class="tag">{catName(item.category)}</span>
    <span class="soon">Photo coming soon</span>
    <span class="booked-pill" data-avail-slot data-slug={item.slug} hidden></span>
  </a>
  <div class="body">
    <h3><a href={href}>{item.name}</a></h3>
    <p class="meta">{item.blurb}</p>
    <ul class="specs">{item.specs.slice(0, 2).map(([k, v]) => <li><span>{k}</span>{v}</li>)}</ul>
    <p class="est-line" data-est hidden></p>
    <div class="foot">
      <div class="price"><span><strong>{money(item.rates[0])}</strong>/day</span><small>{money(item.rates[1])}/wk &middot; {money(item.rates[2])}/mo</small></div>
      <button type="button" class="btn-primary add" data-add data-slug={item.slug} data-name={item.name}><span data-add-label>Add to request</span></button>
    </div>
  </div>
</article>

<style>
  .item-card { background: #fff; border: 1px solid var(--color-wr-border); display: flex; flex-direction: column; transition: box-shadow .2s, transform .2s; }
  .item-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,.08); transform: translateY(-2px); }
  .item-card.hidden { display: none; }
  :global(.item-card.unavail) { opacity: .6; }
  .thumb { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .5rem; aspect-ratio: 4/3; background: var(--color-wr-mid); color: #a9afa9; text-decoration: none; }
  .tag { position: absolute; top: 0; left: 0; background: var(--color-wr-yellow); color: #121212; font-family: var(--font-heading); font-weight: 600; font-size: .7rem; letter-spacing: .1em; text-transform: uppercase; padding: .25rem .6rem; }
  .booked-pill { position: absolute; left: 0; bottom: 0; background: #121212; color: #fff; font-family: var(--font-heading); font-size: .7rem; letter-spacing: .1em; text-transform: uppercase; padding: .3rem .7rem; }
  .soon { font-size: .65rem; letter-spacing: .15em; text-transform: uppercase; }
  .body { padding: 1.1rem 1.1rem 1.25rem; display: flex; flex-direction: column; gap: .5rem; flex: 1; }
  h3 { font-size: 1.2rem; text-transform: uppercase; letter-spacing: .04em; line-height: 1.1; }
  h3 a { color: #121212; text-decoration: none; }
  h3 a:hover { color: #8A5D00; }
  .meta { font-size: .85rem; color: var(--color-wr-muted); line-height: 1.5; }
  .specs { list-style: none; padding: 0; margin: 0; flex: 1; display: grid; gap: .15rem; font-size: .78rem; color: #333; }
  .specs span { color: var(--color-wr-muted); margin-right: .4rem; }
  .specs span::after { content: ':'; }
  .est-line { font-size: .8rem; font-weight: 600; color: #8A5D00; background: #FFF6D6; padding: .35rem .6rem; }
  .est-line.bad { color: #7a2a00; background: #FDE8D8; }
  .foot { display: flex; align-items: center; justify-content: space-between; gap: .75rem; padding-top: .5rem; }
  .price { display: flex; flex-direction: column; line-height: 1.25; font-size: .8rem; color: #444; }
  .price strong { font-family: var(--font-heading); font-size: 1.4rem; color: #121212; }
  .price small { color: var(--color-wr-muted); font-size: .72rem; }
  .add { padding: .55rem 1rem; font-size: .75rem; }
</style>
