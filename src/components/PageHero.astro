---
// J&C-style light page header: eyebrow, small red kicker, big H1, intro, optional buttons, hairline rule.
const { eyebrow, kicker, title, intro, primary, secondary } = Astro.props as {
  eyebrow: string; kicker?: string; title: string; intro?: string;
  primary?: [string, string]; secondary?: [string, string];
};
---
<section class="section-white rule-bottom" style="padding: 4rem 0 4.5rem;">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    {kicker && <p class="eyebrow-strong">{kicker}</p>}
    <h1 class="h1" style="max-width: 46rem;">{title}</h1>
    {intro && <p class="lead" style="max-width: 38rem; margin-top: 1.25rem;">{intro}</p>}
    {(primary || secondary) && (
      <div style="display: flex; gap: .75rem; flex-wrap: wrap; margin-top: 2rem;">
        {primary && <a href={primary[1]} class="btn-primary">{primary[0]}</a>}
        {secondary && <a href={secondary[1]} class="btn-outline">{secondary[0]}</a>}
      </div>
    )}
  </div>
</section>
<style>
  .rule-bottom { border-bottom: 4px solid var(--color-wr-yellow); }
</style>
