---
import { site, featuredCities } from '../data/site';
import { categories } from '../data/equipment';
---
<section class="section-white" style="padding: 4rem 0; border-top: 1px solid var(--color-wr-border);">
  <div class="container cta-row">
    <div>
      <p class="eyebrow">Ready to get started?</p>
      <h2 class="h2" style="margin-bottom: .75rem;">Your rental. Sorted fast.</h2>
      <p class="lead" style="max-width: 32rem;">Send a request or call us and we'll confirm availability within one business day.</p>
    </div>
    <div class="cta-actions">
      <a href="/request" class="btn-primary">Request a Rental</a>
      <a href={site.phoneHref} class="btn-outline">Call {site.phone}</a>
    </div>
  </div>
</section>

<footer>
  <div class="container footer-grid">
    <div>
      <a href="/" class="f-logo"><span class="f-mark">WR</span><span class="f-text">West Ridge <em>Rentals</em></span></a>
      <p class="f-desc">{site.tagline}. Trucks, excavation and landscaping equipment for Utah contractors and businesses.</p>
      <p class="f-contact">
        <a href={site.phoneHref}>{site.phone}</a><br />
        <a href={`mailto:${site.email}`}>{site.email}</a><br />
        {site.address}<br />
        {site.hours}
      </p>
    </div>
    <div>
      <h4>Equipment</h4>
      <ul>{categories.map((c) => <li><a href={`/equipment/${c.slug}`}>{c.name}</a></li>)}</ul>
    </div>
    <div>
      <h4>Quick Links</h4>
      <ul>
        <li><a href="/how-it-works">How It Works</a></li>
        <li><a href="/about">About Us</a></li>
        <li><a href="/service-areas">Service Areas</a></li>
        <li><a href="/contact">Contact</a></li>
        <li><a href="/request">Request a Rental</a></li>
      </ul>
    </div>
    <div>
      <h4>Service Areas</h4>
      <ul>
        {featuredCities.slice(0, 7).map((c) => <li><a href="/service-areas">{c}</a></li>)}
        <li><a href="/service-areas">View All Areas &rarr;</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="container fb-inner">
      <span>&copy; {new Date().getFullYear()} {site.name}. All Rights Reserved.</span>
      <span><a href="/privacy">Privacy Policy</a> &nbsp;|&nbsp; <a href="/terms">Terms &amp; Conditions</a> &nbsp;|&nbsp; Built by <a href="https://3trmedia.com" target="_blank" rel="noopener">3TR Media</a></span>
    </div>
  </div>
</footer>

<style>
  .cta-row { display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
  .cta-actions { display: flex; gap: .75rem; flex-wrap: wrap; }
  footer { background: var(--color-wr-mid); border-top: 1px solid var(--color-wr-border); color: #666; font-size: .9rem; }
  .footer-grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: 2.5rem; padding-top: 4rem; padding-bottom: 3rem; }
  .f-logo { display: flex; align-items: center; gap: .55rem; text-decoration: none; margin-bottom: 1rem; }
  .f-mark { display: grid; place-items: center; width: 2.4rem; height: 2.4rem; background: var(--color-wr-yellow); color: #121212; font-family: var(--font-heading); font-weight: 700; font-size: 1.4rem; }
  .f-text { font-family: var(--font-heading); font-weight: 700; font-size: 1.35rem; letter-spacing: .06em; text-transform: uppercase; color: #121212; }
  .f-text em { font-style: normal; color: #8A5D00; }
  .f-desc { line-height: 1.7; max-width: 24rem; margin-bottom: 1rem; }
  .f-contact { line-height: 1.9; }
  footer a { color: #666; text-decoration: none; transition: color .2s; }
  footer a:hover { color: #8A5D00; }
  footer h4 { font-family: var(--font-heading); font-size: .8rem; letter-spacing: .2em; text-transform: uppercase; color: #8A5D00; margin-bottom: 1rem; }
  footer ul { list-style: none; padding: 0; margin: 0; display: grid; gap: .8rem; }
  .footer-bottom { border-top: 1px solid var(--color-wr-border); padding: 1.1rem 0; font-size: .8rem; }
  .fb-inner { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  @media (max-width: 900px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .footer-grid { grid-template-columns: 1fr; } .fb-inner { flex-direction: column; } }
</style>
