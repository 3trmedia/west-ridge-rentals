---
import { site, featuredCities } from '../data/site';
import { categories, icons } from '../data/equipment';
---
<footer>
  <div class="container footer-grid">
    <div>
      <a href="/" class="f-logo"><span class="f-mark"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons.excavator} /></span><span class="f-text">West Ridge <em>Rentals</em></span></a>
      <p class="f-desc">{site.tagline}. Trucks, excavation and landscaping equipment for Utah contractors, landscapers and homeowners.</p>
      <p class="f-contact">
        <a href={site.phoneHref}>{site.phone}</a><br />
        <a href={`mailto:${site.email}`}>{site.email}</a><br />
        {site.address}<br />
        {site.hours}
      </p>
    </div>
    <div>
      <h4>Equipment</h4>
      <ul>{categories.map((c) => <li><a href={`/equipment/${c.slug}`}>{c.name}</a></li>)}</ul>
    </div>
    <div>
      <h4>Quick Links</h4>
      <ul>
        <li><a href="/how-it-works">How It Works</a></li>
        <li><a href="/about">About Us</a></li>
        <li><a href="/service-areas">Service Areas</a></li>
        <li><a href="/contact">Contact</a></li>
        <li><a href="/request">Request a Rental</a></li>
      </ul>
    </div>
    <div>
      <h4>Service Areas</h4>
      <ul>
        {featuredCities.slice(0, 7).map((c) => <li><a href="/service-areas">{c}</a></li>)}
        <li><a href="/service-areas" class="more">View all areas &rarr;</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="container fb-inner">
      <span>&copy; {new Date().getFullYear()} {site.name}. All rights reserved.</span>
      <span><a href="/privacy">Privacy Policy</a> &nbsp;&middot;&nbsp; <a href="/terms">Terms &amp; Conditions</a> &nbsp;&middot;&nbsp; Built by <a href="https://3trmedia.com" target="_blank" rel="noopener">3TR Media</a></span>
    </div>
  </div>
</footer>

<style>
  footer { background: var(--color-wr-ink); border-top: 4px solid var(--color-wr-yellow); color: #9ba1a8; font-size: .92rem; }
  .footer-grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: 2.5rem; padding-top: 4rem; padding-bottom: 3rem; }
  .f-logo { display: flex; align-items: center; gap: .6rem; text-decoration: none; margin-bottom: 1rem; }
  .f-mark { display: grid; place-items: center; width: 2.45rem; height: 2.45rem; background: var(--color-wr-yellow); color: var(--color-wr-ink); border-radius: 11px; }
  .f-text { font-family: var(--font-heading); font-weight: 800; font-size: 1.22rem; letter-spacing: -.01em; color: #fff; }
  .f-text em { font-style: normal; color: var(--color-wr-yellow); }
  .f-desc { line-height: 1.7; max-width: 24rem; margin-bottom: 1rem; }
  .f-contact { line-height: 1.9; }
  footer a { color: #b7bcc2; text-decoration: none; transition: color .2s; }
  footer a:hover { color: var(--color-wr-yellow); }
  footer h4 { font-family: var(--font-body); font-size: .75rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #fff; margin-bottom: 1rem; }
  footer ul { list-style: none; padding: 0; margin: 0; display: grid; gap: .75rem; }
  .more { color: var(--color-wr-yellow); }
  .footer-bottom { border-top: 1px solid rgba(255,255,255,.1); padding: 1.1rem 0; font-size: .8rem; }
  .fb-inner { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  @media (max-width: 900px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .footer-grid { grid-template-columns: 1fr; } .fb-inner { flex-direction: column; } }
</style>
