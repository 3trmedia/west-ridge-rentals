---
import { site } from '../data/site';
import { categories } from '../data/equipment';
---
<div class="hazard"></div>
<footer class="bg-wr-char border-t border-wr-line">
  <div class="max-w-7xl mx-auto px-4 py-12 grid gap-10 md:grid-cols-4">
    <div class="md:col-span-2">
      <p class="font-display font-bold uppercase tracking-wider text-2xl text-wr-white">West Ridge <span class="text-wr-yellow">Rentals</span></p>
      <p class="mt-3 text-wr-muted max-w-sm">{site.tagline}. Trucks, excavation and landscaping equipment for contractors and businesses statewide.</p>
      <p class="mt-4 text-wr-text">
        <a class="hover:text-wr-yellow" href={site.phoneHref}>{site.phone}</a><br />
        <a class="hover:text-wr-yellow" href={`mailto:${site.email}`}>{site.email}</a><br />
        <span class="text-wr-muted">{site.hours}</span>
      </p>
    </div>
    <div>
      <h4 class="text-lg text-wr-yellow mb-3">Equipment</h4>
      <ul class="space-y-2 text-wr-text">
        {categories.map((c) => <li><a class="hover:text-wr-yellow" href={`/equipment/?category=${c.slug}`}>{c.name}</a></li>)}
      </ul>
    </div>
    <div>
      <h4 class="text-lg text-wr-yellow mb-3">Company</h4>
      <ul class="space-y-2 text-wr-text">
        <li><a class="hover:text-wr-yellow" href="/how-it-works/">How It Works</a></li>
        <li><a class="hover:text-wr-yellow" href="/about/">About</a></li>
        <li><a class="hover:text-wr-yellow" href="/contact/">Contact</a></li>
        <li><a class="hover:text-wr-yellow" href="/privacy/">Privacy Policy</a></li>
        <li><a class="hover:text-wr-yellow" href="/terms/">Terms</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-wr-line text-center text-sm text-wr-muted py-5 px-4">
    &copy; {new Date().getFullYear()} {site.name}. All rights reserved.
  </div>
</footer>
